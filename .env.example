# Provider-agnostic model id, resolved by langchain init_chat_model.
# gpt-4o-mini cannot hold a quantitative rewrite target: on "40% shorter" it stalls
# around 27% and burns the whole retry budget. gpt-4o converges in two attempts.
PR4DOCS_MODEL=openai:gpt-4o

OPENAI_API_KEY=

PR4DOCS_STORAGE=./storage
PR4DOCS_CHECKPOINT_DB=./pr4docs.sqlite

# hard cap on planner retries before the graph gives up
PR4DOCS_MAX_ATTEMPTS=3
